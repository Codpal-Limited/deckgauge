// ── GitHub ────────────────────────────────────────────────────────────────────

model GitHubRepoSync {
  id               String    @id @default(cuid())
  githubInstanceId String    @map("github_instance_id")
  repoFullName     String    @map("repo_full_name")
  defaultBranch    String    @default("main") @map("default_branch")
  archived         Boolean   @default(false)
  language         String?
  topics           String[]  @default([])
  lastPushedAt     DateTime? @map("last_pushed_at")
  openIssuesCount  Int       @default(0) @map("open_issues_count")

  tier String @default("warm") // hot | warm | cold

  prsWatermark          DateTime? @map("prs_watermark")
  commitsWatermark      DateTime? @map("commits_watermark")
  reviewsWatermark      DateTime? @map("reviews_watermark")
  workflowRunsWatermark DateTime? @map("workflow_runs_watermark")
  deploymentsWatermark  DateTime? @map("deployments_watermark")
  issuesWatermark       DateTime? @map("issues_watermark")

  backfillMonths     Int       @default(12) @map("backfill_months")
  backfillCompleteAt DateTime? @map("backfill_complete_at")

  lastSuccessAt    DateTime? @map("last_success_at")
  lastErrorAt      DateTime? @map("last_error_at")
  lastErrorMessage String?   @map("last_error_message")

  disabledAt DateTime? @map("disabled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  githubInstance GitHubInstance      @relation(fields: [githubInstanceId], references: [id], onDelete: Cascade)
  boardSources   BoardGitHubSource[]

  @@unique([githubInstanceId, repoFullName])
  @@index([tier, lastSuccessAt])
  @@index([disabledAt])
  @@map("github_repo_syncs")
}

/// PR-to-Jira-key links, derived from PR titles and commit messages.
///
/// `prId` is NOT a row id — it is the synthetic `"<repoFullName>#<prNumber>"`
/// built by the GitHub intelligence handler. Two organizations syncing the SAME
/// repository therefore produce the identical `prId`, and before this column the
/// unique key made their rows collide: whichever tenant synced last, with its own
/// Jira project-key regex, would `deleteMany` by `prId` and silently destroy the
/// other tenant's links. That is a cross-tenant WRITE, live at one organization
/// too whenever the same repo is connected twice.
///
/// Class D store (tenancy §11 precondition 1): the tenant key is carried
/// explicitly because nothing in `prId` identifies an owner.
model PrJiraLink {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  prId           String    @map("pr_id")
  repoFullName   String    @map("repo_full_name")
  jiraKey        String    @map("jira_key")
  source         String // "pr_title" | "commit_message"
  mergedAt       DateTime? @map("merged_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, prId, jiraKey, source])
  @@index([organizationId, jiraKey])
  @@index([organizationId, repoFullName])
  @@map("pr_jira_links")
}

model BoardGitHubSource {
  id               String  @id @default(uuid())
  boardId          String  @map("board_id")
  gitHubRepoSyncId String  @map("github_repo_sync_id")
  targetGroupId    String? @map("target_group_id")

  syncIssuesToBoard   Boolean  @default(true) @map("sync_issues_to_board")
  useForIntelligence  Boolean  @default(true) @map("use_for_intelligence")
  allowedLabels       String[] @default([]) @map("allowed_labels")
  allowedTypes        String[] @default([]) @map("allowed_types")
  includeClosedIssues Boolean  @default(false) @map("include_closed_issues")
  statusMapping       Json     @default("{}") @map("status_mapping")
  defaultSyncedFields String[] @default(["name", "description", "status", "owner"]) @map("default_synced_fields")

  lastPromotedAt DateTime? @map("last_promoted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  board          Board          @relation(fields: [boardId], references: [id], onDelete: Cascade)
  gitHubRepoSync GitHubRepoSync @relation(fields: [gitHubRepoSyncId], references: [id], onDelete: Cascade)
  targetGroup    Group?         @relation(fields: [targetGroupId], references: [id], onDelete: SetNull)

  @@unique([boardId, gitHubRepoSyncId])
  @@index([boardId])
  @@map("board_github_sources")
}

// ── Azure DevOps ──────────────────────────────────────────────────────────────

model AzureDevOpsProjectSync {
  id                    String @id @default(uuid())
  azureDevOpsInstanceId String @map("azure_devops_instance_id")
  adoProject            String @map("ado_project")

  syncPrs      Boolean  @default(false) @map("sync_prs")
  syncCommits  Boolean  @default(false) @map("sync_commits")
  syncRepos    String[] @default([]) @map("sync_repos")
  syncAllRepos Boolean  @default(false) @map("sync_all_repos")

  lastSyncedAt DateTime? @map("last_synced_at")

  /// Watermark for the Reporting Work Item Revisions sweep that feeds
  /// `ado_transitions`. Without it the sweep re-read every project's full
  /// revision history on every run (~256k rows/cycle across one large org),
  /// which is what got the account throughput-throttled by ADO. Distinct
  /// from `lastSyncedAt`, which is the PR/commit intelligence stamp.
  lastRevisionSyncAt DateTime? @map("last_revision_sync_at")

  /// Watermark for real deployment records (classic Release pipeline
  /// deployments → cockpit.ado_deployments), which DORA's deploy frequency
  /// prefers over the merged-PR proxy. Separate from `lastSyncedAt` for the same
  /// reason as `lastRevisionSyncAt`: deployments are a project-level stream on a
  /// different host (vsrm.dev.azure.com) and must not be tied to the per-repo
  /// PR/commit pass.
  lastDeploymentSyncAt DateTime? @map("last_deployment_sync_at")

  /// Which release pipelines / stages count as a PRODUCTION deploy for this
  /// project. Both empty (the default) means fall back to the name heuristic in
  /// deploymentsUnion.
  ///
  /// Configuration exists because no name rule can separate an operational
  /// pipeline from a deployment one. Shapes seen in real installs:
  /// 'Restart <region> Core Processor', 'Reset IIS', 'Shutdown <service>' and
  /// 'Publish <Lib>Components' (a NuGet publish) must NOT count, while
  /// 'Release-<App>.Dashboard.sln-Master' must. Neither set carries a
  /// prod/production marker.
  ///
  /// When set, these REPLACE the heuristic for the project — including its
  /// default-branch requirement, since an explicit list is authoritative in the
  /// same way GitHub's `production` flag is.
  prodReleaseDefinitions String[] @default([]) @map("prod_release_definitions")
  prodStages             String[] @default([]) @map("prod_stages")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  azureDevOpsInstance AzureDevOpsInstance @relation(fields: [azureDevOpsInstanceId], references: [id], onDelete: Cascade)
  boardSources        BoardAdoSource[]
  repoSyncStates      AdoRepoSyncState[]

  @@unique([azureDevOpsInstanceId, adoProject])
  @@map("azure_devops_project_syncs")
}

// Per-repo intelligence watermark for an ADO project sync. A single project
// can fan out to 50+ repos with tens of thousands of PRs; a single project-level
// `lastSyncedAt` made the sync all-or-nothing, so one transient fetch failure
// aborted the whole project and the watermark never advanced — it re-fetched from
// scratch every run and never completed. This row lets each repo advance its own
// PR/commit watermark independently, so progress is monotonic and a failing repo
// is retried in isolation next run. Mirrors GitHubRepoSync's per-repo lastSyncedAt.
model AdoRepoSyncState {
  id                       String @id @default(uuid())
  azureDevOpsProjectSyncId String @map("azure_devops_project_sync_id")
  repoId                   String @map("repo_id")
  repoName                 String @map("repo_name")

  lastPrSyncAt     DateTime? @map("last_pr_sync_at")
  lastCommitSyncAt DateTime? @map("last_commit_sync_at")

  // Backward-walking backfill cursors. lastPrSyncAt/lastCommitSyncAt only ever
  // move forward, so once they have advanced past a gap in history (e.g. rows
  // lost to a ClickHouse partition drop) nothing re-reads it. These cursors
  // record how far back history has been filled; each run pulls one bounded
  // chunk older than the cursor and moves it back, until it reaches the
  // configured floor. NULL means backfill has not started for that stream.
  prBackfilledUntil     DateTime? @map("pr_backfilled_until")
  commitBackfilledUntil DateTime? @map("commit_backfilled_until")

  // Deployment sync is per PROJECT, not per repo (ADO release pipelines belong
  // to a project), so its watermark lives on AzureDevOpsProjectSync instead.

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  projectSync AzureDevOpsProjectSync @relation(fields: [azureDevOpsProjectSyncId], references: [id], onDelete: Cascade)

  @@unique([azureDevOpsProjectSyncId, repoId])
  @@index([azureDevOpsProjectSyncId])
  @@map("ado_repo_sync_states")
}

model BoardAdoSource {
  id                       String  @id @default(uuid())
  boardId                  String  @map("board_id")
  azureDevOpsProjectSyncId String  @map("azure_devops_project_sync_id")
  targetGroupId            String? @map("target_group_id")

  syncWorkItemsToBoard Boolean  @default(true) @map("sync_work_items_to_board")
  useForIntelligence   Boolean  @default(true) @map("use_for_intelligence")
  allowedWorkItemTypes String[] @default([]) @map("allowed_work_item_types")
  wiqlFilter           String?  @map("wiql_filter")
  fieldMappings        Json     @default("{}") @map("field_mappings")
  statusMapping        Json     @default("{}") @map("status_mapping")
  defaultSyncedFields  String[] @default(["name", "status", "owner"]) @map("default_synced_fields")

  lastPromotedAt DateTime? @map("last_promoted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  board                  Board                  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  azureDevOpsProjectSync AzureDevOpsProjectSync @relation(fields: [azureDevOpsProjectSyncId], references: [id], onDelete: Cascade)
  targetGroup            Group?                 @relation(fields: [targetGroupId], references: [id], onDelete: SetNull)

  @@unique([boardId, azureDevOpsProjectSyncId])
  @@index([boardId])
  @@map("board_ado_sources")
}

// ── GitLab ────────────────────────────────────────────────────────────────────

model GitLabProjectSync {
  id               String @id @default(uuid())
  gitlabInstanceId String @map("gitlab_instance_id")
  projectPath      String @map("project_path")

  syncPrs     Boolean @default(true) @map("sync_prs")
  syncCommits Boolean @default(false) @map("sync_commits")

  lastSyncedAt DateTime? @map("last_synced_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  gitlabInstance GitLabInstance      @relation(fields: [gitlabInstanceId], references: [id], onDelete: Cascade)
  boardSources   BoardGitLabSource[]

  @@unique([gitlabInstanceId, projectPath])
  @@map("gitlab_project_syncs")
}

model BoardGitLabSource {
  id                  String  @id @default(uuid())
  boardId             String  @map("board_id")
  gitlabProjectSyncId String  @map("gitlab_project_sync_id")
  targetGroupId       String? @map("target_group_id")

  syncIssuesToBoard Boolean @default(false) @map("sync_issues_to_board")
  syncMrsToBoard    Boolean @default(false) @map("sync_mrs_to_board")

  lastPromotedAt DateTime? @map("last_promoted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  board             Board             @relation(fields: [boardId], references: [id], onDelete: Cascade)
  gitlabProjectSync GitLabProjectSync @relation(fields: [gitlabProjectSyncId], references: [id], onDelete: Cascade)
  targetGroup       Group?            @relation(fields: [targetGroupId], references: [id], onDelete: SetNull)

  @@unique([boardId, gitlabProjectSyncId])
  @@index([boardId])
  @@map("board_gitlab_sources")
}

// ── Boards Sidebar ────────────────────────────────────────────────────────────

model BoardFolder {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  parentId       String?  @map("parent_id")
  name           String
  color          String   @default("#6366F1")
  position       Float
  isExpanded     Boolean  @default(true) @map("is_expanded")
  organizationId String   @map("organization_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  parent       BoardFolder?      @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     BoardFolder[]     @relation("FolderTree")
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  prefs        UserBoardPref[]
  roadmapPrefs UserRoadmapPref[]
  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, parentId, position])
  @@index([organizationId])
  @@map("board_folders")
}

model UserBoardPref {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  boardId    String   @map("board_id")
  folderId   String?  @map("folder_id")
  position   Float    @default(0)
  isFavorite Boolean  @default(false) @map("is_favorite")
  isHidden   Boolean  @default(false) @map("is_hidden")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  board  Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  folder BoardFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@unique([userId, boardId])
  @@index([userId, folderId, position])
  @@map("user_board_prefs")
}

model OrgTree {
  id              String    @id @default(uuid())
  name            String
  position        Int       @default(0)
  lastSyncedAt    DateTime? @map("last_synced_at")
  lastSyncSummary Json?     @map("last_sync_summary")
  organizationId  String    @map("organization_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  employees       OrgEmployee[]
  employeeBoards  EmployeeBoard[]
  timesheetConfig OrgTreeTimesheetConfig?
  source          OrgTreeSource?
  // Class B: OrgTreeAccess inherits tenancy through this tree, so it carries no
  // organization_id of its own.
  access          OrgTreeAccess[]
  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, position])
  @@map("org_trees")
}

model OrgTreeAccess {
  id        String          @id @default(uuid())
  orgTreeId String          @map("org_tree_id")
  userId    String          @map("user_id")
  role      BoardAccessRole
  /// Salary visibility, ORTHOGONAL to `role` — an EDITOR does not see pay by
  /// virtue of being an EDITOR, which is the whole point of a separate flag.
  /// Someone may need to restructure a tree without seeing pay, and someone else
  /// may need pay without editing anything; a role ladder cannot express that.
  ///
  /// It does not currently REPLACE the admin path: salary is visible when
  /// `isAdmin` OR this flag, controlled by `SALARY_ADMIN_IMPLICIT` in
  /// apps/api/src/org-trees/salary-visibility.ts. Making it exclusive is a
  /// one-line change there plus an owner's decision — see that file's comment for
  /// why the additive direction shipped first.
  canViewSalary Boolean       @default(false) @map("can_view_salary")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  orgTree OrgTree @relation(fields: [orgTreeId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgTreeId, userId])
  @@index([orgTreeId])
  @@index([userId])
  @@map("org_tree_access")
}

model OrgEmployee {
  id                  String                @id @default(uuid())
  orgTreeId           String                @map("org_tree_id")
  externalId          String?               @map("external_id")
  name                String
  role                String?
  email               String?
  managerExternalId   String?               @map("manager_external_id")
  managerId           String?               @map("manager_id")
  position            Int                   @default(0)
  isVacancy           Boolean               @default(false) @map("is_vacancy")
  matched             Boolean               @default(false)
  isActive            Boolean               @default(false) @map("is_active")
  lastContributionAt  DateTime?             @map("last_contribution_at")
  hasAssignment       Boolean               @default(false) @map("has_assignment")
  employeeDisplayId   String?               @map("employee_display_id")
  businessTitle       String?               @map("business_title")
  hireDate            DateTime?             @map("hire_date")
  location            String?
  employeeType        String?               @map("employee_type")
  timeType            String?               @map("time_type")
  phone               String?
  workAddress         String?               @map("work_address")
  salaryCurrent       Int?                  @map("salary_current")
  salaryCurrency      String?               @map("salary_currency")
  statsJson           Json?                 @map("stats_json")
  syncedAt            DateTime?             @map("synced_at")
  msGraphId           String?               @map("ms_graph_id")
  departedAt          DateTime?             @map("departed_at")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  orgTree             OrgTree               @relation(fields: [orgTreeId], references: [id], onDelete: Cascade)
  manager             OrgEmployee?          @relation("Reports", fields: [managerId], references: [id], onDelete: SetNull)
  reports             OrgEmployee[]         @relation("Reports")
  aliases             OrgEmployeeAlias[]
  boardScopes         EmployeeBoard[]       @relation("BoardScope")
  boardMembers        EmployeeBoardMember[]
  employeeFieldValues EmployeeFieldValue[]
  comments            OrgEmployeeComment[]
  uploads             Upload[]

  @@unique([orgTreeId, externalId])
  @@unique([orgTreeId, msGraphId])
  @@index([orgTreeId])
  @@index([managerId])
  @@map("org_employees")
}

model OrgTreeSource {
  id               String    @id @default(uuid())
  orgTreeId        String    @unique @map("org_tree_id")
  provider         String    @default("microsoft")
  rootUpn          String    @map("root_upn")
  rootGraphId      String?   @map("root_graph_id")
  status           String    @default("idle")
  lastSyncedAt     DateTime? @map("last_synced_at")
  lastSyncSummary  Json?     @map("last_sync_summary")
  // Microsoft Graph connection tokens (plaintext, matching the repo's existing
  // Jira/GitHub/ADO/GitLab token convention; localhost-only). msAccessToken is a
  // user-pasted Graph token (no app registration — the primary path); msRefreshToken
  // is a delegated offline token (device-code path). The worker prefers msAccessToken.
  msAccessToken    String?   @map("ms_access_token")
  msRefreshToken   String?   @map("ms_refresh_token")
  microsoftUpn     String?   @map("microsoft_upn")
  connectedByEmail String?   @map("connected_by_email")
  connectedAt      DateTime? @map("connected_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  orgTree          OrgTree   @relation(fields: [orgTreeId], references: [id], onDelete: Cascade)

  @@map("org_tree_sources")
}

model BoardCalendarSource {
  id               String    @id @default(uuid())
  boardId          String    @unique @map("board_id")
  provider         String    @default("microsoft")
  // Whose calendar to read interviews from (email / UPN).
  calendarUpn      String    @default("") @map("calendar_upn")
  // Microsoft Graph connection tokens (plaintext, matching the repo's existing
  // Jira/GitHub/ADO/GitLab/OrgTreeSource token convention; localhost-only).
  // msAccessToken is a user-pasted Graph token (no app registration — the primary
  // path); msRefreshToken is a delegated offline token (device-code path).
  msAccessToken    String?   @map("ms_access_token")
  msRefreshToken   String?   @map("ms_refresh_token")
  microsoftUpn     String?   @map("microsoft_upn")
  status           String    @default("idle")
  lastSyncedAt     DateTime? @map("last_synced_at")
  lastSyncSummary  Json?     @map("last_sync_summary")
  connectedByEmail String?   @map("connected_by_email")
  connectedAt      DateTime? @map("connected_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  board            Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@map("board_calendar_sources")
}

model OrgEmployeeAlias {
  id         String      @id @default(uuid())
  employeeId String      @map("employee_id")
  provider   String
  kind       String
  value      String
  createdAt  DateTime    @default(now()) @map("created_at")
  employee   OrgEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, provider, kind, value])
  @@index([employeeId])
  @@map("org_employee_aliases")
}

model OrgEmployeeComment {
  id            String      @id @default(uuid())
  orgEmployeeId String      @map("org_employee_id")
  employee      OrgEmployee @relation(fields: [orgEmployeeId], references: [id], onDelete: Cascade)
  content       Json
  authorName    String      @default("VP") @map("author_name")
  authorAvatar  String?     @map("author_avatar")
  pinned        Boolean     @default(false)
  /// Author-only when true. Deliberately NOT readable by org admins or by the
  /// tree owner — see the org-tree privacy design's D2: "private except from the
  /// admins" is not private, and the admin bit is an instance-level break-glass
  /// signal granted, on a fresh install, to whoever authenticates first.
  ///
  /// `authorId` is ON DELETE SET NULL, so a private comment whose author is
  /// deleted becomes unreadable by everyone. That is the correct failure
  /// direction: the alternative is a private note turning public the moment its
  /// author is offboarded.
  isPrivate     Boolean     @default(false) @map("is_private")
  authorId      String?     @map("author_id")
  author        User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  uploads       Upload[]
  notifications Notification[]

  @@index([orgEmployeeId, pinned, createdAt])
  // The list and the count both filter on exactly this pair, per employee, on
  // every employee-card open.
  @@index([orgEmployeeId, isPrivate])
  @@index([authorId])
  @@map("org_employee_comments")
}

model EmployeeBoard {
  id              String   @id @default(uuid())
  orgTreeId       String   @map("org_tree_id")
  name            String
  /// Exempt from BOTH implicit-owner rules when true — the org-ADMIN floor inside
  /// `effectiveBoardRole`, and D12's "an OWNER grant on the parent tree owns every
  /// board in it". Only an explicit EmployeeBoardAccess row admits anyone.
  ///
  /// Exempting only one of the two would be worse than exempting neither: it would
  /// read as private while still being readable. Both exemptions live in the
  /// `employeeBoard` policy branch AND in AccessService.getEffectiveRole, which
  /// must agree — one decides whether a request is allowed, the other what the
  /// client renders.
  ///
  /// Listing, renaming and DELETING a personal board are unaffected: an org admin
  /// can always find and destroy, because content nobody can clean up is a worse
  /// problem than content an admin cannot read.
  isPersonal      Boolean  @default(false) @map("is_personal")
  scopeEmployeeId String?  @map("scope_employee_id")
  columnConfig    Json?    @map("column_config")
  position        Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  orgTree OrgTree               @relation(fields: [orgTreeId], references: [id], onDelete: Cascade)
  scope   OrgEmployee?          @relation("BoardScope", fields: [scopeEmployeeId], references: [id], onDelete: SetNull)
  groups  EmployeeGroup[]
  members EmployeeBoardMember[]
  columns EmployeeColumn[]
  // Class B: EmployeeBoardAccess inherits tenancy through this board's tree, so
  // it carries no organization_id of its own (tenancy D6).
  access  EmployeeBoardAccess[]

  @@index([orgTreeId])
  @@map("employee_boards")
}

/// Each board inside an org tree is its own sharing decision (design D12).
/// Org-tree access deliberately does NOT reach it; org ADMINs and org-tree
/// OWNERs are implicit OWNERs so administration still works and an org-tree
/// owner can never create a board they cannot open.
model EmployeeBoardAccess {
  id              String          @id @default(uuid())
  employeeBoardId String          @map("employee_board_id")
  userId          String          @map("user_id")
  role            BoardAccessRole
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  employeeBoard EmployeeBoard @relation(fields: [employeeBoardId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([employeeBoardId, userId])
  @@index([employeeBoardId])
  @@index([userId])
  @@map("employee_board_access")
}

model EmployeeGroup {
  id              String   @id @default(uuid())
  employeeBoardId String   @map("employee_board_id")
  name            String
  color           String   @default("#6366F1")
  position        Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  board   EmployeeBoard         @relation(fields: [employeeBoardId], references: [id], onDelete: Cascade)
  members EmployeeBoardMember[]

  @@index([employeeBoardId])
  @@map("employee_groups")
}

model EmployeeBoardMember {
  id              String   @id @default(uuid())
  employeeBoardId String   @map("employee_board_id")
  orgEmployeeId   String   @map("org_employee_id")
  employeeGroupId String   @map("employee_group_id")
  position        Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")

  board    EmployeeBoard @relation(fields: [employeeBoardId], references: [id], onDelete: Cascade)
  employee OrgEmployee   @relation(fields: [orgEmployeeId], references: [id], onDelete: Cascade)
  group    EmployeeGroup @relation(fields: [employeeGroupId], references: [id], onDelete: Cascade)

  @@unique([employeeBoardId, orgEmployeeId])
  @@index([employeeGroupId, position])
  @@map("employee_board_members")
}

model EmployeeColumn {
  id              String   @id @default(uuid())
  employeeBoardId String   @map("employee_board_id")
  name            String
  type            String
  config          Json?
  position        Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  board       EmployeeBoard        @relation(fields: [employeeBoardId], references: [id], onDelete: Cascade)
  fieldValues EmployeeFieldValue[]

  @@index([employeeBoardId])
  @@map("employee_columns")
}

model EmployeeFieldValue {
  id               String   @id @default(uuid())
  employeeColumnId String   @map("employee_column_id")
  orgEmployeeId    String   @map("org_employee_id")
  value            String
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  column   EmployeeColumn @relation(fields: [employeeColumnId], references: [id], onDelete: Cascade)
  employee OrgEmployee    @relation(fields: [orgEmployeeId], references: [id], onDelete: Cascade)

  @@unique([employeeColumnId, orgEmployeeId])
  @@index([orgEmployeeId])
  @@map("employee_field_values")
}

// ── Cross-board Roadmap ───────────────────────────────────────────────────────

enum RoadmapAccessRole {
  OWNER  @map("owner")
  EDITOR @map("editor")
  VIEWER @map("viewer")

  @@map("roadmap_access_role")
}

enum RoadmapGroupSource {
  MANUAL    @map("manual")
  BOARD_SUB @map("board_sub")

  @@map("roadmap_group_source")
}

enum RoadmapViewType {
  GRID  @map("grid")
  GANTT @map("gantt")

  @@map("roadmap_view_type")
}

model Roadmap {
  id                  String   @id @default(uuid())
  name                String
  description         String?
  createdBy           String   @map("created_by")
  hiddenSystemColumns Json     @default("[]") @map("hidden_system_columns")
  organizationId      String   @map("organization_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  accessEntries RoadmapAccess[]
  subscriptions RoadmapBoardSubscription[]
  groupRefs     RoadmapGroup[]
  views         RoadmapView[]
  prefs         UserRoadmapPref[]
  organization  Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("roadmaps")
}

model RoadmapAccess {
  id        String            @id @default(uuid())
  roadmapId String            @map("roadmap_id")
  userId    String            @map("user_id")
  role      RoadmapAccessRole
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  roadmap Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roadmapId, userId])
  @@index([roadmapId])
  @@index([userId])
  @@map("roadmap_access")
}

model RoadmapBoardSubscription {
  id        String   @id @default(uuid())
  roadmapId String   @map("roadmap_id")
  boardId   String   @map("board_id")
  createdAt DateTime @default(now()) @map("created_at")

  roadmap Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  board   Board   @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@unique([roadmapId, boardId])
  @@index([roadmapId])
  @@map("roadmap_board_subscriptions")
}

model RoadmapGroup {
  id        String             @id @default(uuid())
  roadmapId String             @map("roadmap_id")
  groupId   String             @map("group_id")
  position  Float
  source    RoadmapGroupSource @default(MANUAL)
  createdAt DateTime           @default(now()) @map("created_at")

  roadmap Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([roadmapId, groupId])
  @@index([roadmapId, position])
  @@map("roadmap_groups")
}

model RoadmapView {
  id        String          @id @default(uuid())
  roadmapId String          @map("roadmap_id")
  type      RoadmapViewType
  name      String          @db.VarChar(100)
  position  Int             @default(0)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  roadmap     Roadmap             @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  ganttConfig RoadmapGanttConfig?

  @@index([roadmapId])
  @@map("roadmap_views")
}

model RoadmapGanttConfig {
  id               String      @id @default(uuid())
  roadmapViewId    String      @unique @map("roadmap_view_id")
  roadmapView      RoadmapView @relation(fields: [roadmapViewId], references: [id], onDelete: Cascade)
  startDate        DateTime    @map("start_date")
  visibleQuarters  Int         @default(4) @map("visible_quarters")
  sizeDurations    Json        @map("size_durations")
  defaultSizeWeeks Float       @default(2) @map("default_size_weeks")
  hiddenGroupIds   Json        @default("[]") @map("hidden_group_ids")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  @@map("roadmap_gantt_configs")
}

model UserRoadmapPref {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  roadmapId  String   @map("roadmap_id")
  folderId   String?  @map("folder_id")
  position   Float    @default(0)
  isFavorite Boolean  @default(false) @map("is_favorite")
  isHidden   Boolean  @default(false) @map("is_hidden")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmap Roadmap      @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  folder  BoardFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@unique([userId, roadmapId])
  @@index([userId, folderId, position])
  @@map("user_roadmap_prefs")
}

// ── Timesheet ─────────────────────────────────────────────────────────────────

model TimesheetStatusRule {
  id                 String             @id @default(uuid())
  scope              TimesheetRuleScope
  role               String?
  employeeId         String?            @map("employee_id")
  inProgressStatuses String[]           @default([]) @map("in_progress_statuses")
  organizationId     String             @map("organization_id")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Explicitly named: the Prisma default would exceed Postgres' 63-char identifier limit.
  @@unique([organizationId, scope, role, employeeId], map: "timesheet_status_rules_org_scope_role_employee_key")
  @@index([organizationId])
  @@map("timesheet_status_rules")
}

model OrgTreeTimesheetConfig {
  orgTreeId      String   @id @map("org_tree_id")
  activeStatuses String[] @default([]) @map("active_statuses")
  // Per-day working-hours cap. null = use the engine default (8h); 0 = uncapped.
  dailyCapHours  Float?   @map("daily_cap_hours")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  orgTree        OrgTree  @relation(fields: [orgTreeId], references: [id], onDelete: Cascade)

  @@map("org_tree_timesheet_configs")
}

model RetiredJiraProject {
  projectKey     String   @map("project_key")
  cutoffDate     DateTime @map("cutoff_date")
  note           String?
  organizationId String   @map("organization_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Composite PK: a project key is only unique within one organization.
  @@id([organizationId, projectKey])
  @@index([organizationId])
  @@map("retired_jira_projects")
}

// ── Advisor ───────────────────────────────────────────────────────────────────

// One row per organization. Stores the advisor's LLM provider config. apiKey is
// stored as-is for v1 (encrypted-at-rest is a follow-up) and must never be
// returned to the client.
model AdvisorConfig {
  id             String  @id @default(cuid())
  provider       String
  apiKey         String?
  baseUrl        String?
  model          String
  organizationId String  @unique @map("organization_id")

  /// Operator off switch for the Advisor's source-lookup tools (`search_source`
  /// / `read_source`). Default ON: those tools read only source this repo
  /// already publishes under FSL-1.1-Apache-2.0, and they are bounded by a path
  /// allowlist. An operator who keeps private modules inside the source tree
  /// turns it off here. A deployment configured purely from `.env` has no row to
  /// set, and uses `ADVISOR_SOURCE_LOOKUP` instead — a saved row wins, matching
  /// `AdvisorConfigService.getConfig`'s existing precedence.
  sourceLookupEnabled Boolean @default(true)

  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// One advisor conversation, owned by a single user and pinned to one board.
// Per-board because the advisor's tools only read that board's data — a
// transcript resumed against a different board would cite numbers its own
// history never came from.
model AdvisorSession {
  id        String   @id @default(cuid())
  boardId   String   @map("board_id")
  userId    String   @map("user_id")
  // Derived from the first question; empty until that question is appended.
  title     String   @default("")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  board    Board            @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AdvisorMessage[]

  @@index([userId, boardId, updatedAt])
  @@map("advisor_sessions")
}

model AdvisorMessage {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  // 'user' | 'assistant'. Kept as a string rather than an enum so a future
  // role needs no migration; the Zod schema in @deckgauge/shared is the gate.
  role      String
  text      String
  // Names of the tools run for this turn; assistant turns only.
  toolCalls Json?    @map("tool_calls")
  createdAt DateTime @default(now()) @map("created_at")

  session AdvisorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("advisor_messages")
}

enum AdvisorChangeSetStatus {
  PENDING
  APPLIED
  DISCARDED
  STALE
  EXPIRED

  @@map("advisor_change_set_status")
}

/// A batch of board edits the Advisor proposed and a human has not yet applied.
///
/// The model that proposes one cannot apply it: there is no apply tool on the
/// MCP surface, and the apply endpoint authorizes the human's own JWT.
model AdvisorChangeSet {
  id              String                 @id @default(uuid())
  boardId         String                 @map("board_id")
  /// The tenant predicate, stored rather than derived: board id plus creator is
  /// not a tenant check (TENANCY-PROGRAMME §5a).
  organizationId  String                 @map("organization_id")
  createdByUserId String                 @map("created_by_user_id")
  status          AdvisorChangeSetStatus @default(PENDING)
  /// One-line human summary, computed server-side at propose time.
  summary         String
  /// The validated op list, in order. Read as a whole; never queried per-op.
  ops             Json
  /// The row-level preview the human approves — this, verbatim, is what they
  /// signed off on. Apply does NOT recompute and value-compare this preview
  /// against the board: it re-validates that every id an op names (rows,
  /// groups, statuses) still exists and still belongs to this board, which
  /// catches the entities-vanished case (STALE) without freezing the feature
  /// on a busy board where fields have merely changed value since propose.
  /// Value-level drift detection is deferred to stage 3, where the UI can
  /// re-render a fresh preview immediately before Apply.
  preview         Json
  expiresAt       DateTime               @map("expires_at")
  appliedAt       DateTime?              @map("applied_at")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  board     Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  createdBy User  @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([boardId, status])
  @@index([createdByUserId, status])
  @@index([organizationId])
  @@map("advisor_change_sets")
}

/// In-app notification. IN-APP ONLY — email and push are out of scope
/// (VP-Cockpit-PRD.md:84, planning/REQUIREMENTS.md:41).
///
/// Holds REFERENCES ONLY: no board name, no comment excerpt, no project title.
/// A notification names an entity the recipient can lose access to, so what they
/// are allowed to see is resolved at READ time through the same access helpers
/// every other read uses. A denormalised label here would be a second, frozen
/// copy of who-can-see-what — exactly the thing that goes stale and leaks.
model Notification {
  id             String @id @default(uuid())
  /// Not redundant with `userId`: under multi-org one User holds memberships in
  /// several organizations, and the switcher decides which one they are looking
  /// at. Without this column the bell would mix tenants.
  organizationId String @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// The recipient. NOT nullable — a notification nobody can read is a bug.
  userId String @map("user_id")
  user   User   @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  /// Who caused it. Nullable only so a deleted User does not destroy the
  /// notification: "you were mentioned" still means something.
  actorId String? @map("actor_id")
  actor   User?   @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  kind    NotificationKind

  /// AT MOST ONE typed subject is set — a CHECK constraint in the migration
  /// enforces it, because two subjects is ambiguous. "No subject at all" is legal
  /// SOLELY so a DIGEST summary row can exist. Cascading deletes mean a deleted
  /// comment takes its notifications with it, so no route has to remember.
  projectCommentId     String? @map("project_comment_id")
  projectComment       ProjectComment? @relation(fields: [projectCommentId], references: [id], onDelete: Cascade)
  orgEmployeeCommentId String? @map("org_employee_comment_id")
  orgEmployeeComment   OrgEmployeeComment? @relation(fields: [orgEmployeeCommentId], references: [id], onDelete: Cascade)

  /// Item subject: assigned, status/due-date changed, due soon, overdue,
  /// automation, comment added. Cascades, so a deleted item takes its
  /// notifications with it.
  projectId String?  @map("project_id")
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// The sharing family. Polymorphic rather than five more FK columns, because
  /// sharing is ALREADY generic here: `ACCESS_ENTITIES` is a descriptor map keyed
  /// by AccessEntityKind. No FK is possible (the target table varies) — dangling
  /// rows are dropped at read time by `resolve`, the same mechanism that hides a
  /// subject the reader lost access to.
  shareKind     String? @map("share_kind")
  shareEntityId String? @map("share_entity_id")

  /// Kind-specific extras ONLY — old/new status, an automation's message, a
  /// digest's counts. Never labels, names or hrefs: those stay resolved at read
  /// time, because a stored label is a frozen copy of who-can-see-what.
  payload Json?

  /// Set on rows folded into a released digest, so the summary can expand into
  /// them. SetNull, not Cascade: deleting the summary must not delete the real
  /// events it summarised.
  digestId String?        @map("digest_id")
  digest   Notification?  @relation("DigestMembers", fields: [digestId], references: [id], onDelete: SetNull)
  members  Notification[] @relation("DigestMembers")

  /// A DIGEST-mode row awaiting release: hidden from both the bell list and the
  /// unread count until the hourly job folds it into a summary.
  digestPending Boolean @default(false) @map("digest_pending")

  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@index([organizationId])
  /// The release job's query: this user's pending rows, oldest first.
  @@index([userId, digestPending, createdAt])
  @@map("notifications")
}

/// The full trigger set (notification system §3), plus DIGEST for the summary
/// row a released digest writes. An enum rather than a string so a new kind is a
/// migration and a compile error, not a silently-mistyped literal.
enum NotificationKind {
  MENTION
  ITEM_ASSIGNED
  ITEM_STATUS_CHANGED
  ITEM_DUE_DATE_CHANGED
  ITEM_COMMENT_ADDED
  ITEM_DUE_SOON
  ITEM_OVERDUE
  ENTITY_SHARED
  ACCESS_ROLE_CHANGED
  ORG_MEMBER_INVITED
  AUTOMATION_NOTIFY
  DIGEST

  // The mapped, lower-snake name is what actually exists in Postgres — the same
  // convention as project_status and board_access_role. Without this the client
  // casts to "public.NotificationKind" and every write fails 42704.
  @@map("notification_kind")
}

/// A deliberate per-kind choice. SPARSE — absent means "use the default in
/// DEFAULT_NOTIFICATION_MODES", so a default change is a code change rather than
/// a migration over every user who never opened the settings screen.
model NotificationPreference {
  id             String           @id @default(uuid())
  userId         String           @map("user_id")
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Preferences are per-tenant: the same person can want different things in
  /// two organizations, exactly as the notifications themselves are scoped.
  organizationId String           @map("organization_id")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind           NotificationKind
  /// TEXT, not a Postgres enum: it is read only by code that already holds the
  /// Zod enum, and a CHECK makes adding a mode a one-line change, not ALTER TYPE.
  mode           String
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@unique([userId, organizationId, kind])
  @@map("notification_preferences")
}

/// "Notify me about everything here / mentions only / nothing." Also sparse:
/// absent means ALL.
model BoardNotificationSetting {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  boardId   String   @map("board_id")
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  level     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, boardId])
  @@index([boardId])
  @@map("board_notification_settings")
}
