generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  NOT_STARTED @map("Not started")
  IN_PROGRESS @map("In progress")
  AT_RISK     @map("At risk")
  BLOCKED     @map("Blocked")
  DONE        @map("Done")

  @@map("project_status")
}

enum CostClassification {
  CAPEX
  OPEX

  @@map("cost_classification")
}

enum SyncRunStatus {
  PENDING   @map("pending")
  COMPLETED @map("completed")
  FAILED    @map("failed")

  @@map("sync_run_status")
}

enum SyncRunTrigger {
  STARTUP   @map("startup")
  MANUAL    @map("manual")
  SCHEDULED @map("scheduled")

  @@map("sync_run_trigger")
}

enum ColumnType {
  TEXT     @map("text")
  STATUS   @map("status")
  DATE     @map("date")
  NUMBER   @map("number")
  CHECKBOX @map("checkbox")
  DROPDOWN @map("dropdown")
  PERSON   @map("person")
  LINK     @map("link")

  @@map("column_type")
}

enum AzureDevOpsAuthMethod {
  PAT   @map("pat")
  BASIC @map("basic")

  @@map("azure_devops_auth_method")
}

enum SyncSource {
  ADO
  GITHUB
  JIRA
  GITLAB

  @@map("sync_source")
}

enum TimesheetRuleScope {
  ROLE
  EMPLOYEE

  @@map("timesheet_rule_scope")
}

// ── Organization tenancy ──────────────────────────────────────────────────────
// See docs/superpowers/specs/2026-08-05-org-tenancy-foundation-design.md §4.

enum OrgRole {
  ADMIN
  MEMBER
  VIEWER

  @@map("org_role")
}

enum OrgMembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED

  @@map("org_membership_status")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships OrgMembership[]

  // One back-relation per tenant root (spec §4.2 Class A). Models added since
  // the spec was written are all Class B — they inherit tenancy through a
  // parent listed here: OrgTreeAccess via orgTreeId, AdvisorSession via
  // boardId, AdvisorMessage via its session. None needs a column of its own.
  boards               Board[]
  roadmaps             Roadmap[]
  orgTrees             OrgTree[]
  comparisons          Comparison[]
  boardFolders         BoardFolder[]
  jiraInstances        JiraInstance[]
  githubInstances      GitHubInstance[]
  azureDevOpsInstances AzureDevOpsInstance[]
  gitlabInstances      GitLabInstance[]
  advisorConfig        AdvisorConfig?
  timesheetStatusRules TimesheetStatusRule[]
  retiredJiraProjects  RetiredJiraProject[]
  prJiraLinks          PrJiraLink[]
  developerProfiles    DeveloperProfile[]
  syncRuns             SyncRun[]
  notifications        Notification[]
  notificationPreferences NotificationPreference[]

  @@map("organizations")
}

model OrgMembership {
  id              String              @id @default(uuid())
  organizationId  String              @map("organization_id")
  email           String // lowercased; the invite key
  userId          String?             @map("user_id") // null until first login binds it
  role            OrgRole
  status          OrgMembershipStatus @default(PENDING)
  invitedByUserId String?             @map("invited_by_user_id")
  invitedAt       DateTime            @default(now()) @map("invited_at")
  activatedAt     DateTime?           @map("activated_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitedMemberships", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, email])
  @@unique([organizationId, userId])
  @@index([organizationId, status])
  @@index([userId])
  @@index([email])
  @@map("org_memberships")
}

model Board {
  id                 String   @id @default(uuid())
  name               String
  description        String?
  // Board template the board was seeded from / behaves as. "development" = the
  // historical default board (dashboard + roadmap); "blank" = empty board;
  // "recruitment" = a candidate pipeline (seeded groups/columns + opt-in
  // calendar/onboard capabilities). Drives boardCapabilities() gating.
  kind               String   @default("development")
  // Phase 3 (EI-001): ticket-key prefixes the board cares about (e.g. ["BWAY","DOS"]).
  // Used by the intelligence layer to scope ClickHouse queries to the boards
  // that should see a given linked_ticket_keys[] entry.
  ticketKeyPrefixes  String[] @default([]) @map("ticket_key_prefixes")
  hiddenSystemFields String[] @default(["startDate", "endDate", "duration"]) @map("hidden_system_fields")
  // Monday-style per-board grid layout: { hidden: string[], widths: Record<colKey, number> }.
  // Column keys are the SYSTEM_COLUMN_KEYS (packages/shared) or a custom BoardColumn.id.
  columnLayout       Json?    @map("column_layout")
  organizationId     String   @map("organization_id")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  groups                Group[]
  projects              Project[]
  columns               BoardColumn[]
  automations           AutomationRule[]
  // Phase 3 multi-board sync: one row per (board × project-sync).
  boardJiraSources      BoardJiraSource[]
  boardGithubSources    BoardGitHubSource[]
  boardAdoSources       BoardAdoSource[]
  boardGitlabSources    BoardGitLabSource[]
  owners                BoardOwner[]
  statuses              BoardStatus[]
  accessEntries         BoardAccess[]
  views                 BoardView[]
  userPrefs             UserBoardPref[]
  syncExclusions        BoardSyncExclusion[]
  roadmapSubscriptions  RoadmapBoardSubscription[]
  calendarEvents        BoardCalendarEvent[]
  comparisonMemberships ComparisonMember[]
  notificationSettings  BoardNotificationSetting[]
  calendarSource        BoardCalendarSource?
  advisorSessions       AdvisorSession[]
  advisorChangeSets     AdvisorChangeSet[]
  organization          Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, createdAt], map: "boards_organization_id_created_at_idx")
  @@map("boards")
}

model BoardCalendarEvent {
  id        String   @id @default(uuid())
  boardId   String?  @map("board_id") // null = global event
  label     String   @db.VarChar(120)
  kind      String   @db.VarChar(20) // 'freeze' | 'migration' | 'holiday'
  startsAt  DateTime @map("starts_at")
  endsAt    DateTime @map("ends_at")
  color     String?  @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  board     Board?   @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId])
  @@map("board_calendar_events")
}

model BoardOwner {
  id        String   @id @default(uuid())
  boardId   String   @map("board_id")
  name      String   @db.VarChar(100)
  color     String   @db.VarChar(7)
  order     Int      @default(0)
  userId    String?  @map("user_id")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board    Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  projects Project[]

  @@unique([boardId, name])
  @@index([boardId])
  @@index([userId])
  @@map("board_owners")
}

model BoardStatus {
  id        String   @id @default(uuid())
  boardId   String   @map("board_id")
  label     String   @db.VarChar(50)
  color     String   @db.VarChar(7)
  icon      String?  @db.VarChar(10)
  order     Int      @default(0)
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board    Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  projects Project[]

  @@unique([boardId, label])
  @@index([boardId])
  @@map("board_statuses")
}

model BoardSyncExclusion {
  id         String     @id @default(uuid())
  boardId    String     @map("board_id")
  source     SyncSource
  externalId String     @map("external_id")
  excludedAt DateTime   @default(now()) @map("excluded_at")
  excludedBy String?    @map("excluded_by")

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@unique([boardId, source, externalId])
  @@index([boardId, source])
  @@map("board_sync_exclusions")
}

model Group {
  id        String   @id @default(uuid())
  name      String
  position  Int      @default(0)
  color     String   @default("#6C6CFF")
  boardId   String   @map("board_id")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board              Board               @relation(fields: [boardId], references: [id], onDelete: Cascade)
  projects           Project[]
  // Phase 3 multi-board sync target-group relations.
  boardJiraSources   BoardJiraSource[]
  boardGithubSources BoardGitHubSource[]
  boardAdoSources    BoardAdoSource[]
  boardGitlabSources BoardGitLabSource[]
  roadmapGroups      RoadmapGroup[]

  @@index([boardId, position])
  @@map("groups")
}

model Project {
  id                      String              @id @default(uuid())
  name                    String
  owner                   String
  assignee                String              @default("")
  /// Field keys a human has edited and not yet reverted. Sync skips these
  /// cells. Keys are the registry vocabulary in
  /// packages/shared/src/sync-field-registry.ts — plain names for Project
  /// scalars, `col:<columnId>` for ProjectFieldValue rows.
  overriddenFields        String[]            @default([]) @map("overridden_fields")
  /// For each key in overriddenFields, the value the field held immediately
  /// before its FIRST manual edit — what "revert to synced value" restores.
  /// Written only by that first edit; sync never touches it. Entries are pruned
  /// on revert, so this stays as small as the dirty set.
  preOverrideValues       Json?               @map("pre_override_values")
  status                  ProjectStatus
  description             String?
  boardId                 String?             @map("board_id")
  groupId                 String?             @map("group_id")
  ownerId                 String?             @map("owner_id")
  statusId                String?             @map("status_id")
  order                   Float?
  jiraKey                 String?             @map("jira_key")
  jiraProjectKey          String?             @map("jira_project_key")
  jiraType                String?             @map("jira_type")
  jiraSyncedFields        Json?               @map("jira_synced_fields")
  jiraRemovedFromSource   Boolean             @default(false) @map("jira_removed_from_source")
  /// Set once the Jira sync has CONFIRMED (via a per-key existence probe, not
  /// mere absence from a fetch) that this row's Jira issue is gone. Distinct
  /// from jiraRemovedFromSource, which also covers a row dropped by a board's
  /// JQL or issue-type filter. Also the record of which keys were purged from
  /// ClickHouse, since that purge is not reversible.
  jiraDeletedAt           DateTime?           @map("jira_deleted_at")
  /// When the deleted issue's analytics rows were actually dropped from
  /// ClickHouse. Deletion and purge are two steps and the second can fail
  /// (ClickHouse down) after the first has committed; a row deleted-but-not-
  /// purged is the next sync's retry list, which is why this is not just a flag
  /// on jiraDeletedAt.
  jiraAnalyticsPurgedAt   DateTime?           @map("jira_analytics_purged_at")
  githubIssueId           String?             @map("github_issue_id")
  githubRepoFullName      String?             @map("github_repo_full_name")
  githubSyncedFields      String[]            @default([]) @map("github_synced_fields")
  githubRemovedFromSource Boolean             @default(false) @map("github_removed_from_source")
  adoWorkItemId           Int?                @map("ado_work_item_id")
  adoProject              String?             @map("ado_project")
  adoSyncedFields         Json?               @map("ado_synced_fields")
  adoRemovedFromSource    Boolean             @default(false) @map("ado_removed_from_source")
  roadmapPinnedStart      DateTime?           @map("roadmap_pinned_start")
  startDate               DateTime?           @map("start_date")
  endDate                 DateTime?           @map("end_date")
  dueDate                 DateTime?           @map("due_date")
  durationCode            String?             @map("duration_code")
  costClassification      CostClassification? @map("cost_classification")
  // Recruitment: set when a candidate row has been onboarded into an org tree as an
  // OrgEmployee. Loosely references OrgEmployee.id; guards against double-onboarding.
  onboardedEmployeeId     String?             @map("onboarded_employee_id")
  // Recruitment calendar ingest: the Microsoft-calendar event this candidate row was
  // created from. Null for normal rows; unique per board so re-syncs update, not
  // duplicate. Postgres treats NULLs as distinct, so many null rows coexist.
  calendarEventId         String?             @map("calendar_event_id")
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  board         Board?                @relation(fields: [boardId], references: [id], onDelete: Cascade)
  group         Group?                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  boardOwner    BoardOwner?           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  boardStatus   BoardStatus?          @relation(fields: [statusId], references: [id], onDelete: Cascade)
  fieldValues   ProjectFieldValue[]
  comments      ProjectComment[]
  uploads       Upload[]
  statusChanges ProjectStatusChange[]
  notifications Notification[]

  @@unique([boardId, jiraKey, jiraProjectKey])
  @@unique([boardId, adoWorkItemId])
  @@unique([boardId, githubIssueId])
  @@unique([boardId, calendarEventId])
  @@index([boardId, status])
  @@index([boardId, updatedAt])
  @@index([boardId, ownerId])
  @@index([groupId, order])
  @@map("projects")
}

model ProjectComment {
  id           String   @id @default(uuid())
  projectId    String   @map("project_id")
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  content      Json
  authorName   String   @default("VP") @map("author_name")
  authorAvatar String?  @map("author_avatar")
  pinned       Boolean  @default(false)
  authorId     String?  @map("author_id")
  author       User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  uploads       Upload[]
  notifications Notification[]

  @@index([projectId, pinned, createdAt])
  @@index([authorId])
  @@map("project_comments")
}

model BoardColumn {
  id      String     @id @default(uuid())
  boardId String
  name    String
  type    ColumnType
  order   Int        @default(0)
  config  Json?

  board       Board               @relation(fields: [boardId], references: [id], onDelete: Cascade)
  fieldValues ProjectFieldValue[]

  @@index([boardId, order])
  @@map("board_columns")
}

model ProjectFieldValue {
  id        String @id @default(uuid())
  projectId String
  columnId  String
  value     String

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  column  BoardColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@unique([projectId, columnId])
  @@map("project_field_values")
}

model AutomationRule {
  id        String   @id @default(uuid())
  boardId   String   @map("board_id")
  name      String
  trigger   Json
  action    Json
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@map("automation_rules")
}

model JiraInstance {
  id           String   @id @default(uuid())
  name         String
  atlassianUrl String
  email        String
  apiToken     String
  projectKeys  String[]
  createdAt    DateTime @default(now())

  // Two orthogonal ownership axes, deliberately both present:
  // `organizationId` is the TENANT boundary — a cross-organization id resolves
  // to 404, never to another tenant's token. `createdById` is ownership WITHIN
  // that organization (authz hardening). Null means "unclaimed" — pre-existing
  // rows from before this column existed, or rows whose creator was later
  // deleted (onDelete: SetNull). Nothing claims a null `createdById` any more:
  // the CONNECTION_OWNER policy that used to read it was deleted in Phase C, and
  // claim-on-first-edit went with it, because a label reading "Added by" must not
  // name whoever merely edited the row first. Access is `ownerUserId` below.
  organizationId String  @map("organization_id")
  createdById    String? @map("created_by_id")
  createdBy      User?   @relation("CreatedJiraInstances", fields: [createdById], references: [id], onDelete: SetNull)
  /// Whose connection this is. NULL means organization-wide: every member may
  /// use it. A user id means personal: only that user (and an organization
  /// ADMIN) may. Stamped from the creator's role at creation and never
  /// re-derived, so promoting or demoting somebody cannot move a connection
  /// across the boundary.
  ///
  /// Deliberately NOT `createdById`, which stays provenance for the "Added by"
  /// label and is never a gate — reusing it as one is the `connectionOwner`
  /// mistake Phase C removed.
  ///
  /// onDelete: Restrict, because SetNull here would turn a personal connection
  /// into an organization-wide one when a user row is deleted, publishing a
  /// credential. No route deletes a user today.
  ownerUserId    String? @map("owner_user_id")
  owner          User?   @relation("OwnedJiraInstances", fields: [ownerUserId], references: [id], onDelete: Restrict)

  projectSyncs JiraProjectSync[] // Phase 3
  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, ownerUserId])
  @@map("jira_instances")
}

model SyncRun {
  id String @id @default(uuid())

  // The tenant whose connection this run synced (tenancy §11 precondition 1).
  //
  // A run is not attributable after the fact: all four *SyncId columns below are
  // DEAD — declared for Phase 3 and never written by any code path — and
  // `source` names a provider, not an owner. So the tenant is passed IN at
  // creation, from the organizationId of the connection the run is for. All
  // three writers (the Jira, GitHub and ADO sync processors) are already called
  // from a handler that loops per instance, so it is in scope at every call
  // site, and it is a REQUIRED processor input for the same reason `instanceId`
  // is: a future caller cannot forget it and quietly write an untenanted row.
  //
  // Why it matters more than a status word: `errorMessage` is the provider's
  // failure text, verbatim, and routinely names a repository, an ADO team
  // project or an Atlassian host. Both sync-status routes served the
  // deployment's newest run to any authenticated caller.
  organizationId String @map("organization_id")

  status        SyncRunStatus
  trigger       SyncRunTrigger
  startedAt     DateTime       @default(now())
  finishedAt    DateTime?
  errorMessage  String?
  epicCount     Int            @default(0)
  issueCount    Int            @default(0)
  source        String?
  workItemCount Int            @default(0) @map("work_item_count")

  // Phase 3: link a sync run to the new project-sync models. All
  // optional and unscoped (no FK constraint) so legacy *SyncConfig-based
  // runs continue to write rows without touching these fields.
  //
  // NOTE (2026-08-26): all four are DEAD COLUMNS. Nothing in apps/ or packages/
  // ever writes one — verified by sweeping every `syncRun.create`/`update` call
  // site — so they are NULL in every row and cannot attribute a run to a tenant.
  // That is precisely why `organizationId` above has to be passed in rather than
  // derived, and why the backfill in
  // `20260826000500_sync_run_tenant_key` has no join available to it.
  jiraProjectSyncId        String? @map("jira_project_sync_id")
  githubRepoSyncId         String? @map("github_repo_sync_id")
  azureDevOpsProjectSyncId String? @map("azure_devops_project_sync_id")
  gitlabProjectSyncId      String? @map("gitlab_project_sync_id")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Serves the only read of this table — `where { organizationId, source }`
  // ordered by `startedAt desc` — with the tenant first, so no reader can scan
  // across tenants on it.
  @@index([organizationId, source, startedAt])
  @@index([organizationId, status])
  // Kept, tenant-free and deliberately so: the worker's daily retention job
  // (`pruneSyncRuns`) deletes every organization's runs older than 7 days in one
  // statement. It is deployment-wide by design, not an unscoped tenant read.
  @@index([startedAt])
  @@map("sync_runs")
}

model Upload {
  id                String              @id @default(uuid())
  filename          String
  mimeType          String              @map("mime_type")
  sizeBytes         Int                 @map("size_bytes")
  commentId         String?             @map("comment_id")
  comment           ProjectComment?     @relation(fields: [commentId], references: [id], onDelete: Cascade)
  projectId         String?             @map("project_id")
  project           Project?            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  orgEmployeeId     String?             @map("org_employee_id")
  orgEmployee       OrgEmployee?        @relation(fields: [orgEmployeeId], references: [id], onDelete: Cascade)
  employeeCommentId String?             @map("employee_comment_id")
  employeeComment   OrgEmployeeComment? @relation(fields: [employeeCommentId], references: [id], onDelete: Cascade)
  createdAt         DateTime            @default(now()) @map("created_at")

  @@index([projectId])
  @@index([commentId])
  @@index([orgEmployeeId])
  @@index([employeeCommentId])
  @@map("uploads")
}

model GitHubInstance {
  id          String   @id @default(uuid())
  baseUrl     String   @default("https://api.github.com") @map("base_url")
  accessToken String   @map("access_token")
  org         String   @default("")
  // DEPRECATED — read-only. Use GitHubRepoSync rows instead. Backfilled by
  // migration <ts>_github_bulk_repo_ingestion. Kept for one release for safety.
  repos       String[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Tenant boundary + within-org ownership — see JiraInstance for the full rule.
  organizationId String  @map("organization_id")
  createdById    String? @map("created_by_id")
  createdBy      User?   @relation("CreatedGitHubInstances", fields: [createdById], references: [id], onDelete: SetNull)
  /// Whose connection this is. NULL means organization-wide: every member may
  /// use it. A user id means personal: only that user (and an organization
  /// ADMIN) may. Stamped from the creator's role at creation and never
  /// re-derived, so promoting or demoting somebody cannot move a connection
  /// across the boundary.
  ///
  /// Deliberately NOT `createdById`, which stays provenance for the "Added by"
  /// label and is never a gate — reusing it as one is the `connectionOwner`
  /// mistake Phase C removed.
  ///
  /// onDelete: Restrict, because SetNull here would turn a personal connection
  /// into an organization-wide one when a user row is deleted, publishing a
  /// credential. No route deletes a user today.
  ownerUserId    String? @map("owner_user_id")
  owner          User?   @relation("OwnedGitHubInstances", fields: [ownerUserId], references: [id], onDelete: Restrict)

  repoSyncs    GitHubRepoSync[] // Phase 3
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, ownerUserId])
  @@map("github_instances")
}

model AzureDevOpsInstance {
  id          String                @id @default(uuid())
  name        String
  orgUrl      String                @map("org_url")
  authMethod  AzureDevOpsAuthMethod @map("auth_method")
  accessToken String                @map("access_token")
  username    String?
  projects    String[]
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  // Tenant boundary + within-org ownership — see JiraInstance for the full rule.
  organizationId String  @map("organization_id")
  createdById    String? @map("created_by_id")
  createdBy      User?   @relation("CreatedAzureDevOpsInstances", fields: [createdById], references: [id], onDelete: SetNull)
  /// Whose connection this is. NULL means organization-wide: every member may
  /// use it. A user id means personal: only that user (and an organization
  /// ADMIN) may. Stamped from the creator's role at creation and never
  /// re-derived, so promoting or demoting somebody cannot move a connection
  /// across the boundary.
  ///
  /// Deliberately NOT `createdById`, which stays provenance for the "Added by"
  /// label and is never a gate — reusing it as one is the `connectionOwner`
  /// mistake Phase C removed.
  ///
  /// onDelete: Restrict, because SetNull here would turn a personal connection
  /// into an organization-wide one when a user row is deleted, publishing a
  /// credential. No route deletes a user today.
  ownerUserId    String? @map("owner_user_id")
  owner          User?   @relation("OwnedAzureDevOpsInstances", fields: [ownerUserId], references: [id], onDelete: Restrict)

  projectSyncs AzureDevOpsProjectSync[] // Phase 3
  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, ownerUserId])
  @@map("azure_devops_instances")
}

enum BoardAccessRole {
  OWNER
  EDITOR
  VIEWER

  @@map("board_access_role")
}

enum BoardViewType {
  BOARD      @map("board")
  DASHBOARD  @map("dashboard")
  ROADMAP    @map("roadmap")
  COMPARISON @map("comparison")

  @@map("board_view_type")
}

model User {
  id                   String   @id @default(uuid())
  keycloakId           String   @unique @map("keycloak_id")
  email                String   @unique
  name                 String
  /// Split name, from the `given_name` / `family_name` claims. Nullable because
  /// rows created before this existed have only a combined `name`, and a token
  /// may legitimately carry neither.
  firstName            String?  @map("first_name")
  lastName             String?  @map("last_name")
  avatarUrl            String?  @map("avatar_url")
  /// Database-side administrator flag, OR'd with the Keycloak `cockpit-admin`
  /// realm-role claim in keycloak-auth.plugin.ts. Exists because a realm role
  /// cannot be granted to an install that has already imported its realm —
  /// realm-export.json seeds fresh imports only.
  isAdmin              Boolean  @default(false) @map("is_admin")
  /// Which organization this person is currently acting in, when they belong to
  /// more than one (tenancy §11 precondition 2).
  ///
  /// A PREFERENCE, not a grant: it is honoured only when it still names a
  /// membership they hold, and ignored — falling back to the deterministic
  /// default in MembershipService.resolveForUser — when it is stale. So revoking
  /// a membership takes effect without anyone having to clear this column, and a
  /// deliberately-set value can never widen access.
  ///
  /// On the User rather than in the session so the choice survives a token
  /// refresh and a new device, and so it is auditable. No FK: the referenced
  /// organization may be deleted, and a dangling value must degrade to "ignored"
  /// rather than block the delete or cascade a surprise.
  activeOrganizationId String?  @map("active_organization_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  boardAccess         BoardAccess[]
  boardOwners         BoardOwner[]
  comments            ProjectComment[]
  // Two relations to Notification, so both need explicit names: one for the
  // person who is notified, one for the person who caused it.
  notifications       Notification[] @relation("NotificationRecipient")
  actedNotifications  Notification[] @relation("NotificationActor")
  developerProfiles   DeveloperProfile[]
  boardFolders        BoardFolder[]
  boardPrefs          UserBoardPref[]
  roadmapAccess       RoadmapAccess[]
  roadmapPrefs        UserRoadmapPref[]
  employeeComments    OrgEmployeeComment[]
  orgTreeAccess       OrgTreeAccess[]
  employeeBoardAccess EmployeeBoardAccess[]
  comparisonAccess    ComparisonAccess[]
  advisorSessions     AdvisorSession[]
  advisorChangeSets   AdvisorChangeSet[]
  notificationPreferences  NotificationPreference[]
  boardNotificationSettings BoardNotificationSetting[]

  // Creator-scoped provider connections (authz hardening). A deleted user's
  // connections become unclaimed (createdById set null), not destroyed —
  // see onDelete: SetNull on each instance model's createdBy relation.
  createdJiraInstances        JiraInstance[]        @relation("CreatedJiraInstances")
  createdGitHubInstances      GitHubInstance[]      @relation("CreatedGitHubInstances")
  createdAzureDevOpsInstances AzureDevOpsInstance[] @relation("CreatedAzureDevOpsInstances")
  createdGitLabInstances      GitLabInstance[]      @relation("CreatedGitLabInstances")

  // Connections this user OWNS — personal connections, as opposed to the
  // `created*` relations above, which are provenance only. Both sides need
  // explicit @relation names because there are now TWO relations between User and
  // each instance model, which Prisma cannot disambiguate on its own.
  //
  // onDelete: Restrict lives on the instance side: SetNull would turn a personal
  // connection into an organization-wide one when a user row is deleted, which
  // publishes a credential.
  ownedJiraInstances        JiraInstance[]        @relation("OwnedJiraInstances")
  ownedGitHubInstances      GitHubInstance[]      @relation("OwnedGitHubInstances")
  ownedAzureDevOpsInstances AzureDevOpsInstance[] @relation("OwnedAzureDevOpsInstances")
  ownedGitLabInstances      GitLabInstance[]      @relation("OwnedGitLabInstances")

  // Membership is the join — User itself is intentionally untenanted (spec §4.2
  // Class C): one person can hold memberships in several organizations.
  orgMemberships     OrgMembership[]
  invitedMemberships OrgMembership[] @relation("InvitedMemberships")

  @@map("users")
}

/// The developer-identity map: which provider login is which local user, plus
/// the display name and email the sync saw. A tenant root (§4.2 class A).
///
/// It was untenanted, classified §4.2 class C on the grounds that "a GitHub
/// login is a global fact". True of the LOGIN and false of the ROW: the row is
/// a per-tenant assertion ABOUT a login — which of MY users it is, what MY
/// sync saw. Class C was applied to the key and silently inherited by the
/// record hanging off it, which left `@@unique([provider, login])` as a
/// deployment-global identity: two organizations whose data contained the same
/// login resolved to ONE row and overwrote each other's PII on every sync.
/// Same shape as `PrJiraLink`'s `"<repo>#<number>"` before slice 6a.
model DeveloperProfile {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  provider       String   @db.VarChar(32)
  login          String   @db.VarChar(256)
  displayName    String?  @map("display_name") @db.VarChar(256)
  avatarUrl      String?  @map("avatar_url")
  email          String?  @db.VarChar(320)
  userId         String?  @map("user_id")
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider, login])
  @@index([organizationId, userId])
  @@index([organizationId, email])
  @@map("developer_profiles")
}

model BoardAccess {
  id        String          @id @default(uuid())
  boardId   String          @map("board_id")
  userId    String          @map("user_id")
  role      BoardAccessRole
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@index([boardId])
  @@index([userId])
  @@map("board_access")
}

model BoardView {
  id        String        @id @default(uuid())
  boardId   String        @map("board_id")
  type      BoardViewType
  name      String        @db.VarChar(100)
  position  Int           @default(0)
  presetKey String?       @map("preset_key") @db.VarChar(50)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  board              Board             @relation(fields: [boardId], references: [id], onDelete: Cascade)
  widgets            DashboardWidget[]
  roadmapConfigGantt RoadmapConfig?    @relation("RoadmapGanttConfig")

  @@index([boardId])
  @@index([presetKey])
  @@map("board_views")
}

// Multi-board comparison: a first-class, standalone entity (reached through the
// Comparisons category, not a board tab). Owned by its creator, like Roadmap;
// kept lean like OrgTree (no per-entity ACL / favorites). Its member boards are
// the developers' boards being compared.
model Comparison {
  id             String   @id @default(uuid())
  name           String   @db.VarChar(100)
  /// Provenance only. NOT an access check — ComparisonAccess decides that as of
  /// design D15. Any query that reaches for this as a gate reintroduces
  /// creator-only behaviour for that path.
  createdBy      String   @map("created_by")
  organizationId String   @map("organization_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  members      ComparisonMember[]
  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Class B: ComparisonAccess inherits tenancy through this comparison's own
  // organization_id, so it carries none of its own (tenancy D6).
  access       ComparisonAccess[]

  @@index([createdBy])
  @@index([organizationId])
  @@map("comparisons")
}

/// A comparison's per-user ACL, replacing creator-only access (design D15).
/// Uses BoardAccessRole: a third enum for the same three values would be the
/// divergence D10 exists to remove.
model ComparisonAccess {
  id           String          @id @default(uuid())
  comparisonId String          @map("comparison_id")
  userId       String          @map("user_id")
  role         BoardAccessRole
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  comparison Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([comparisonId, userId])
  @@index([comparisonId])
  @@index([userId])
  @@map("comparison_access")
}

// The ordered board set for a Comparison. FK cascade so deleting the comparison
// or a member board cleans up its rows.
model ComparisonMember {
  id           String   @id @default(uuid())
  comparisonId String   @map("comparison_id")
  boardId      String   @map("board_id")
  position     Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")

  comparison Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  board      Board      @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@unique([comparisonId, boardId])
  @@index([comparisonId, position])
  @@map("comparison_members")
}

model RoadmapConfig {
  id               String    @id @default(uuid())
  boardViewId      String    @unique @map("board_view_id")
  boardView        BoardView @relation("RoadmapGanttConfig", fields: [boardViewId], references: [id], onDelete: Cascade)
  startDate        DateTime  @map("start_date")
  visibleQuarters  Int       @default(4) @map("visible_quarters")
  sizeDurations    Json      @map("size_durations")
  defaultSizeWeeks Float     @default(2) @map("default_size_weeks")
  hiddenGroupIds   Json      @default("[]") @map("hidden_group_ids")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("roadmap_configs")
}

model DashboardWidget {
  id          String   @id @default(uuid())
  boardViewId String   @map("board_view_id")
  widgetType  String   @map("widget_type") @db.VarChar(50)
  title       String   @db.VarChar(100)
  config      Json     @default("{}")
  layout      Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  boardView BoardView @relation(fields: [boardViewId], references: [id], onDelete: Cascade)

  @@index([boardViewId])
  @@map("dashboard_widgets")
}

model ProjectStatusChange {
  id         String   @id @default(uuid())
  projectId  String   @map("project_id")
  fromStatus String?  @map("from_status")
  toStatus   String   @map("to_status")
  changedAt  DateTime @default(now()) @map("changed_at")
  changedBy  String?  @map("changed_by")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, changedAt])
  @@index([toStatus, changedAt])
  @@map("project_status_changes")
}

// ============================================================================
// Phase 3 (EI-001) — multi-board sync models per planning/MULTI-BOARD-SYNC.md.
// Adds new tables only; legacy *SyncConfig models stay through Sprint 2 (EI-016c)
// for backwards compatibility while workers migrate over.
// ============================================================================

// GitLab support is brand new in Phase 3 — the underlying Instance model
// didn't exist yet. Pattern mirrors GitHubInstance.
model GitLabInstance {
  id          String   @id @default(uuid())
  name        String
  baseUrl     String   @default("https://gitlab.com/api/v4") @map("base_url")
  accessToken String   @map("access_token")
  projects    String[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Tenant boundary + within-org ownership — see JiraInstance for the full rule.
  organizationId String  @map("organization_id")
  createdById    String? @map("created_by_id")
  createdBy      User?   @relation("CreatedGitLabInstances", fields: [createdById], references: [id], onDelete: SetNull)
  /// Whose connection this is. NULL means organization-wide: every member may
  /// use it. A user id means personal: only that user (and an organization
  /// ADMIN) may. Stamped from the creator's role at creation and never
  /// re-derived, so promoting or demoting somebody cannot move a connection
  /// across the boundary.
  ///
  /// Deliberately NOT `createdById`, which stays provenance for the "Added by"
  /// label and is never a gate — reusing it as one is the `connectionOwner`
  /// mistake Phase C removed.
  ///
  /// onDelete: Restrict, because SetNull here would turn a personal connection
  /// into an organization-wide one when a user row is deleted, publishing a
  /// credential. No route deletes a user today.
  ownerUserId    String? @map("owner_user_id")
  owner          User?   @relation("OwnedGitLabInstances", fields: [ownerUserId], references: [id], onDelete: Restrict)

  projectSyncs GitLabProjectSync[]
  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, ownerUserId])
  @@map("gitlab_instances")
}

