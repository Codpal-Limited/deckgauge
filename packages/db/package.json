{
  "name": "@deckgauge/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --build",
    "generate": "DATABASE_URL=${DATABASE_URL:-postgresql://cockpit:cockpit@localhost:5433/cockpit} prisma generate",
    "migrate:deploy": "DATABASE_URL=${DATABASE_URL:-postgresql://cockpit:cockpit@localhost:5433/cockpit} prisma migrate deploy",
    "migrate:dev": "DATABASE_URL=${DATABASE_URL:-postgresql://cockpit:cockpit@localhost:5433/cockpit} prisma migrate dev",
    "migrate:clickhouse": "tsx src/clickhouse-migrate.ts",
    "seed": "DATABASE_URL=${DATABASE_URL:-postgresql://cockpit:cockpit@localhost:5433/cockpit} tsx seed.ts",
    "grant-owner": "DATABASE_URL=${DATABASE_URL:-postgresql://cockpit:cockpit@localhost:5433/cockpit} tsx scripts/grant-owner-access.ts",
    "grant:org-access": "tsx src/scripts/grant-org-access.ts",
    "bootstrap:admin": "tsx src/scripts/bootstrap-admin.ts",
    "migrate:ch-org-tenancy": "tsx src/scripts/ch-org-tenancy-migrate.ts",
    "ch:retrofit-read-identity": "tsx src/scripts/ch-retrofit-read-identity.ts",
    "ch:reprovision-organizations": "tsx src/scripts/ch-reprovision-organizations.ts",
    "test:db:reset": "tsx src/scripts/reset-test-database.ts",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint ."
  },
  "dependencies": {
    "@clickhouse/client": "^1.19.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@deckgauge/test-utils": "workspace:*",
    "@types/pg": "^8.11.10",
    "dotenv": "^16.4.5",
    "prisma": "^7.10.0",
    "tsx": "^4.15.7",
    "vitest": "^4.1.4"
  }
}
