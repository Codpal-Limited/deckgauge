// The typecheck gate's view of this package: the SAME tsconfig, minus the
// `exclude` that keeps `*.test.ts` out of `tsc --build`, and emitting nothing.
//
// This package has no test files today. It is wired anyway, so the first one
// added lands INSIDE the gate rather than outside it.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "rootDir": "../.."
  },
  "exclude": [
    "node_modules",
    "dist"
  ]
}
