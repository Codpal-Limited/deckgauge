# Per-developer test overrides. apps/api/.env.test is TRACKED and must stay so;
# this is where you point a run at a different database without dirtying it.
.env.test.local
#
# BACKUPS OF .env, which the two rules above do NOT cover — they match those two
# names EXACTLY. `.env.bak-before-clickhouse-keys` and `.env.bak-mailpitport` both
# existed untracked in the primary checkout, each holding the complete live
# credential set in cleartext, each offered by `git status` as a staging
# candidate. Copying `.env` aside before editing it is what the upgrade
# instructions in README.md tell an operator to do, so the pattern recurs.
#
# Listed rather than written as `.env.*` with negations, deliberately: `.env.*`
# matches `apps/api/.env.test`, `deploy/env.hosted.example`, `.env.example` and
# `demo/env.demo.example`, all of which are TRACKED. Both halves of that — these
# ignored, those not — are asserted by
# apps/api/src/__isolation__/default-credentials.test.ts through
# `git check-ignore`, so a later widening fails the gate rather than silently
# untracking four templates.
#
# scripts/init-env.sh --force writes its own backup as `.env.bak-<timestamp>`,
# which the first rule covers by construction rather than by convention.
.env.bak*
.env.backup*
.env.orig
.env.save
.env~
.DS_Store
.worktrees/
.claude/
.superpowers/
build-output.txt
apps/web/test-results/
apps/api/uploads/
backups/
.codegraph/

# License signing material + generated licenses — NEVER commit
.license-keys/
*.license

# Personal commercialization docs — keep out of git
Business Plan/

# Advisor local-agent bridge runtime state (scripts/advisor-bridge.sh)
.advisor-bridge.pid
.advisor-bridge.log

# OSS_Staging throwaway snapshot (lives outside the repo; defensive)
/deckgauge-oss-staging/
../deckgauge-oss-staging/

# Hosted deployment secrets — never commit
deploy/.env.hosted
# Same for the free-demo box. demo/env.demo.example opens with "never commit",
# but only the example was tracked — the real file was ignored by nothing, and it
# gets created by hand on the VM and by anyone rendering the demo overlay
# locally (`docker compose -f docker-compose.yml -f demo/docker-compose.demo.yml`
# requires it to exist). It carries NEXTAUTH_SECRET and KEYCLOAK_CLIENT_SECRET.
demo/.env.demo

# Prisma 7 client, generated by `pnpm --filter @deckgauge/db generate`.
# Not committed: it is derived from schema.prisma. It IS required in the build
# context, because the Docker images cannot generate it themselves (the CLI's
# schema engine is a Linux binary this network blocks) — scripts/deploy-staging.sh
# regenerates it on the host before `docker compose build`.
packages/db/src/generated/
