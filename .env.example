# Copy this file to .env and fill in values for local development.

# ── Published host ports ──
#
# Only the HOST side of each docker-compose mapping. Container ports never move,
# so nothing inside the compose network is affected by anything set here.
#
# Leave them unset and every port is the default below — which is also what
# docker-compose.yml renders with no .env at all, so a fresh clone and the
# open-source distribution behave identically to how they always have.
#
# Set them to run this stack ALONGSIDE a second installation that expects the
# defaults (the public open-source build). Three things must move with them or
# the app breaks in ways that never mention a port:
#   1. the URL values further down this file (DATABASE_URL, REDIS_URL,
#      NEXT_PUBLIC_API_URL, NEXTAUTH_URL, KEYCLOAK_ISSUER, DECKGAUGE_API_URL);
#   2. KC_HOSTNAME_PORT, or Keycloak issues tokens and redirects on the old port;
#   3. the vp-cockpit-web client's redirectUris/webOrigins inside the RUNNING
#      Keycloak. realm-export.json is imported only into an EMPTY Keycloak DB,
#      so on an existing stack neither this file nor KEYCLOAK_PUBLIC_ORIGIN can
#      reach it — it takes kcadm against the live server. Symptom if missed:
#      "Invalid parameter: redirect_uri" at login, with the app otherwise fine.
#
# KEYCLOAK_JWKS_URI is deliberately NOT in this list: it is fetched from inside
# the api container, so it stays on the service name and port 8080 forever.
# scripts/check-pinned-env.sh enforces that.
# WEB_PORT=3000
# API_PORT=3001
# SITE_PORT=3020
# POSTGRES_PORT=5433
# REDIS_PORT=6379
# KEYCLOAK_PORT=8080
# CLICKHOUSE_HTTP_PORT=8123
# CLICKHOUSE_NATIVE_PORT=9000
# KC_HOSTNAME_PORT=8080
# KEYCLOAK_PUBLIC_ORIGIN=http://localhost:3000

# Postgres connection
POSTGRES_USER=cockpit
POSTGRES_PASSWORD=cockpit
POSTGRES_DB=cockpit
DATABASE_URL="postgresql://cockpit:cockpit@localhost:5433/cockpit"

# Redis connection
REDIS_URL="redis://localhost:6379"

# Jira configuration file path
JIRA_CONFIG_PATH="config/jira.yaml"

# Azure DevOps configuration
ADO_CONFIG_PATH="config/azure-devops.yaml"
USE_FAKE_AZURE_DEVOPS='true'

# ADO code-intelligence history backfill (PRs + commits).
# The forward watermarks only move forward, so a gap in history never heals on
# its own. Setting ADO_BACKFILL_ENABLED=1 makes each sync run pull ONE bounded
# chunk of older history per repo (capped at ADO_BACKFILL_REPOS_PER_RUN repos)
# and walk backwards until it reaches the floor. Off by default: it multiplies
# ADO request volume, and ADO has throttled this account before.
# ADO_BACKFILL_ENABLED=1
# ADO_BACKFILL_CHUNK_DAYS=30
# ADO_BACKFILL_FLOOR_DAYS=365
# ADO_BACKFILL_REPOS_PER_RUN=5

# Per-organization concurrency cap on the worker's GitHub tier queues
# (hot/warm/cold). Only meaningful for POOLED multi-tenant hosting, where one
# organization's large sync would otherwise occupy every slot and stall the
# others. A job over its organization's cap is pushed back onto the delayed set
# instead of holding the worker slot.
# Unset or 0 = disabled, which is the single-organization/self-host default and
# behaves exactly as it did before the cap existed.
# WORKER_MAX_CONCURRENT_JOBS_PER_ORG=2

# API base URL accessible from the browser (used for image uploads)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Keycloak (V2 — IAM integration)
KEYCLOAK_ISSUER=http://localhost:8080/realms/vp-cockpit
KEYCLOAK_CLIENT_ID=vp-cockpit-web
KEYCLOAK_CLIENT_SECRET=vp-cockpit-secret
# KEYCLOAK_ISSUER is browser-facing: it must equal the `iss` claim Keycloak
# stamps into tokens, which is driven by the keycloak service's KC_HOSTNAME.
#
# KEYCLOAK_JWKS_URI is NOT browser-facing. The API fetches it from inside its
# own container, so it must use the compose service name. `localhost` there is
# the API container itself, and every request then fails JWT verification with
#   connect ECONNREFUSED 127.0.0.1:8080 -> "continuing unauthenticated" -> 401
# which presents as a fully loaded app whose every board looks empty.
#
# This used to be masked: docker-compose.yml hardcoded the correct in-container
# value and ignored .env entirely. Once that became `${KEYCLOAK_JWKS_URI:-...}`,
# a stale .env carrying localhost started winning over the correct default.
KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/vp-cockpit/protocol/openid-connect/certs

# Keycloak's own Postgres database (docker-compose keycloak-db + keycloak
# services). Defaults below match the shipped image; change before exposing
# an instance beyond localhost.
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak

# Keycloak admin console credentials (KEYCLOAK_ADMIN / KEYCLOAK_ADMIN_PASSWORD
# on the keycloak container). Defaults below match the shipped image; change
# before exposing an instance beyond localhost.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# (No NEXT_PUBLIC_KEYCLOAK_* vars: NEXT_PUBLIC_* is inlined into the browser
# bundle at build time, so it cannot describe the Keycloak of whatever install
# runs the image. Login and logout both read KEYCLOAK_ISSUER at runtime instead.)

# NextAuth.js (V2)
NEXTAUTH_SECRET=change-me-in-production
NEXTAUTH_URL=http://localhost:3000

# Integration tests
DATABASE_TEST_URL=postgresql://cockpit:cockpit@localhost:5433/cockpit_test

# Microsoft Entra ID SSO (optional — leave blank to disable)
# Request these values from your Azure AD admin: register an app in Entra ID,
# add a web redirect URI for your Keycloak broker endpoint, and issue a client
# secret. Leaving any of them blank disables the identity provider entirely.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ─── SMTP (forgot-password) ────────────────────────────────────────────────
#
# Keycloak's reset-credentials flow is enabled in the realm, and Keycloak sends
# mail over SMTP only — there is no API alternative.
#
# LEAVE ALL OF THIS BLANK for local development. The defaults point at the
# `mailpit` container in docker-compose.yml, which accepts every message and
# delivers none: trigger a reset, then read the link at http://localhost:8025.
# Nothing leaves your machine and no account is needed anywhere.
#
# To deliver real mail, set SMTP_HOST/PORT/USER/PASSWORD to your relay and
# SMTP_FROM to an address on a domain you control. SMTP_AUTH is DERIVED — set
# SMTP_USER and authentication turns itself on; override only to force it off.
#
# Worked example (Brevo's free tier, 300/day, no card):
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_STARTTLS=true
#   SMTP_USER=<your brevo login>
#   SMTP_PASSWORD=<your brevo SMTP key>
#   SMTP_FROM=no-reply@deckgauge.com
#
# The FROM domain must be one you have verified with the relay (SPF/DKIM), or
# the mail is silently spam-filed. Note this need not be — and should not be —
# your company mail domain; a dedicated sending domain keeps reset mail off your
# corporate reputation.
#
# CAVEAT: these values are substituted into the realm JSON with sed, so a
# password containing a literal " or \ needs care. Ampersands, pipes and
# backslashes are escaped for you; quotes are not. Brevo/Mailjet/SES keys are
# alphanumeric, so this is a non-issue in practice.
SMTP_HOST=
SMTP_PORT=
SMTP_FROM=
SMTP_FROM_DISPLAY_NAME=
SMTP_REPLY_TO=
SMTP_SSL=
SMTP_STARTTLS=
# Leave blank to derive from SMTP_USER.
SMTP_AUTH=
SMTP_USER=
SMTP_PASSWORD=

# Microsoft Graph directory sync (optional — leave blank to disable the Source tab)
# Needs an Entra app registration with the User.Read.All APPLICATION permission + admin consent.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Set USE_FAKE_GRAPH=true to run the worker without real Graph credentials.
USE_FAKE_GRAPH=

# ── Advisor (board Q&A) — see docs/advisor-local-agent.md ──
# The Advisor can get a model in two independent ways; either is enough.
#
# 1. A server-side provider, set here or in Settings → Advisor. Leave
#    ADVISOR_PROVIDER blank and the advisor reports itself unconfigured
#    (the panel then links to the settings page).
#    A config saved in the UI takes precedence over these variables.
# 'anthropic' or 'ollama'.
ADVISOR_PROVIDER=
# e.g. claude-haiku-4-5 (anthropic) or llama3.2 (ollama).
ADVISOR_MODEL=
# Anthropic only. Read ONLY from this namespaced variable — a bare
# ANTHROPIC_API_KEY in your environment is deliberately never picked up.
ADVISOR_ANTHROPIC_API_KEY=
# Ollama only. Must include the scheme, e.g. http://localhost:11434.
ADVISOR_OLLAMA_BASE_URL=
#
# 2. Your own local Claude Code / Codex session, via the local-agent bridge —
#    no key, no model config, nothing leaves your machine. `pnpm dev` already
#    starts it. When the rest of the stack runs in Docker the bridge still has
#    to run on the host (a container has neither the ACP adapter nor your agent
#    login) — `pnpm advisor:start` runs it detached.
#
#    ADVISOR_BRIDGE_AUTOSTART is a convention for *deploy steps*, not something
#    scripts/advisor-bridge.sh reads: that script always starts the bridge when
#    you call it. Deckgauge's own deploy step checks this variable and starts
#    the bridge unless it is `false`; if you wire your own, honour it the same
#    way or ignore it:
ADVISOR_BRIDGE_AUTOSTART=
# Optional. The Advisor panel authenticates the bridge automatically with
# your own signed-in Deckgauge session — leave this blank. Set it only to run
# the bridge headless, with no browser involved at all.
DECKGAUGE_TOKEN=
#
#    The bridge reads DECKGAUGE_API_URL, DECKGAUGE_TOKEN and the ADVISOR_*
#    variables from this file — and nothing else in it, so the local agent it
#    spawns never inherits your database URL or client secrets. A variable
#    already set in your shell always wins over the value here.
#
# Base URL of the Deckgauge API; the bridge appends /mcp itself. Change it if
# you publish the API on another port. The bridge runs on the host, so this is
# always a host URL — never a container name.
DECKGAUGE_API_URL=http://localhost:3001
# Origins the bridge's WebSocket server accepts a handshake from. Leave blank
# (the default) and it accepts any loopback origin — localhost, 127.0.0.0/8,
# [::1] — on ANY port, so the Advisor works wherever you published the web app.
# Set it, comma-separated, only to pin an exact list or to allow a LAN hostname
# you browse Deckgauge from. A non-empty list REPLACES the loopback rule, so
# include your own local origin if you still use it, e.g.
# http://localhost:3000,http://deckgauge.box.local:3000
ADVISOR_ALLOWED_ORIGINS=

# ── Open-core edition switch ──
# 'community' (default) or 'enterprise'. Community is fully open and
# self-hostable on its own; Enterprise adds licensed features (SSO, advanced
# RBAC, works-council mode, retention, audit logs, and more than one
# organization per installation) and ships as a separate module that is not part
# of this repository. Leave this alone unless you have licensed it.
DECKGAUGE_EDITION=community
# Absolute path to the built enterprise module entry (enterprise edition only;
# the path is given to you with that module).
DECKGAUGE_ENTERPRISE_MODULE=
# Absolute path to the signed license file (enterprise edition only). Under
# Docker this is a path INSIDE the container, below the read-only .license-keys
# mount the api service declares — e.g. /app/.license-keys/acme.license.
# Unset, unreadable or unsigned means no licensed features, which is the safe
# direction to fail in.
DECKGAUGE_LICENSE_FILE=
# Host directory bind-mounted read-only at /app/.license-keys in the api
# container. Defaults to ./.license-keys.
DECKGAUGE_LICENSE_DIR=
# DEV/TEST ONLY — trust an extra verify key from DECKGAUGE_LICENSE_PUBKEY so
# locally-generated licenses validate. NEVER set to 1 in production.
DECKGAUGE_ALLOW_DEV_LICENSE_KEYS=
DECKGAUGE_LICENSE_PUBKEY=

# ClickHouse must be allowed to manage its own roles and row policies, because
# organization isolation IS row policies. Leave this at 1 unless you are
# deliberately running without tenant isolation — the policy baseline fails
# loudly rather than silently leaving every table world-readable.
CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT=1


# ── ClickHouse per-organization read identity ──
# The SEPARATE ClickHouse login the API scopes analytics reads through, one role
# per query. Leave BLANK unless you are running more than one organization on a
# shared ClickHouse: blank means reads run through the ingest connection that
# docker-compose builds from CLICKHOUSE_USER / CLICKHOUSE_PASSWORD, which spans
# every organization.
#
# When you do set it:
#   • It must be a DIFFERENT ClickHouse user from CLICKHOUSE_USER. The ingest user
#     carries a permissive 'USING 1' row policy on every object so the worker can
#     write for every tenant, and ClickHouse row policies combine with OR — so
#     reading through it ignores whatever role a query asks for. Provisioning
#     refuses the same-user configuration rather than letting it look like it worked.
#   • Create the user with NO row policy of its own and NO direct
#     'GRANT SELECT ON cockpit.*'. Its privileges arrive through the
#     per-organization roles that provisioning grants it, which is what makes a
#     query with no role fail closed (ACCESS_DENIED) instead of silently reading
#     nothing.
#   • Needs ClickHouse >= 24.8; the per-query role parameter does not exist before it.
# A ClickHouse migration refuses to run if this names a user that does not exist,
# or one that already holds a blanket permissive policy.
#
# The login name is normally read out of the URL's userinfo, which is all a
# container is handed. CLICKHOUSE_READ_USER overrides it when the two need to
# differ; setting the name WITHOUT a URL is a half-configuration and the API logs
# a warning at boot rather than silently reading through the ingest identity.
CLICKHOUSE_READ_URL=
CLICKHOUSE_READ_USER=

# ─────────────────────────────────────────────────────────────────────────────
# Multi-organization
# ─────────────────────────────────────────────────────────────────────────────
# The OPERATOR's half of the gate on creating a SECOND organization. Leave it off
# unless you mean it.
#
# It is half, not the whole: more than one organization per installation is an
# ENTERPRISE entitlement, so a second organization needs BOTH this flag and a
# licence carrying `multi_org` (DECKGAUGE_LICENSE_FILE above). Community answers
# no however this is set. The two halves are independent on purpose — renewing
# into a tier that happens to include multi_org must not silently convert a
# single-tenant deployment into a multi-tenant one behind whoever runs it.
#
# Narrower than the name suggests: the only code that reads it is
# OrganizationService.bootstrap, where it decides whether the one-organization cap
# applies and whether an admin-less organization is adopted by the slug you name.
# Every tenant-scoping check in the API is unconditional, so this does not switch
# multi-org behaviour on — it stops preventing a second tenant from existing.
#
# Two things to know before enabling it:
#
#   1. It is a one-way door in practice. The first second organization creates
#      rows that any remaining unscoped read would mix together.
#   2. Split the ClickHouse read path FIRST (CLICKHOUSE_READ_URL above). While it
#      is empty, analytics read as the ingest identity, whose permissive
#      `ingest_all … USING 1` policy ORs past every per-organization row policy —
#      so per-tenant analytics isolation is a no-op until you split it.
#
# Also note that turning this on does not give a second tenant a way to sign
# itself up: POST /organizations/bootstrap is gated on instance ADMIN, which on a
# fresh install is granted to the first user to authenticate. Creating tenant #2
# means an operator granting its first admin that instance-level signal.
#
# Before each release a rehearsal harness stands up a throwaway stack with this
# on and both halves configured, and probes the isolation guarantees end to end.
DECKGAUGE_MULTI_ORG=false
