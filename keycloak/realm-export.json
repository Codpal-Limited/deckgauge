{
  "realm": "deckgauge",
  "displayName": "Deckgauge",
  "enabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": true,
  "smtpServer": {
    "host": "__SMTP_HOST__",
    "port": "__SMTP_PORT__",
    "from": "__SMTP_FROM__",
    "fromDisplayName": "__SMTP_FROM_DISPLAY_NAME__",
    "replyTo": "__SMTP_REPLY_TO__",
    "envelopeFrom": "",
    "ssl": "__SMTP_SSL__",
    "starttls": "__SMTP_STARTTLS__",
    "auth": "__SMTP_AUTH__",
    "user": "__SMTP_USER__",
    "password": "__SMTP_PASSWORD__"
  },
  "loginTheme": "deckgauge",
  "clients": [
    {
      "clientId": "deckgauge-web",
      "enabled": true,
      "publicClient": false,
      "secret": "__CLIENT_SECRET__",
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:3010/*",
        "http://localhost:3030/*",
        "__PUBLIC_ORIGIN__/*"
      ],
      "webOrigins": ["http://localhost:3000", "http://localhost:3010", "http://localhost:3030", "__PUBLIC_ORIGIN__"],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "attributes": {
        "post.logout.redirect.uris": "__POST_LOGOUT_REDIRECT_URIS__"
      }
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "cockpit-admin",
        "description": "Full administrative access: salary read/write, Owner-equivalent access on every org tree, and implies cockpit-analytics. Does not bypass board access checks — boards still require their own BoardAccess role."
      },
      {
        "name": "cockpit-analytics",
        "description": "Read access to engineering-intelligence dashboards. A timesheet read that names an org tree also requires Viewer on that tree; one with no tree needs only this role. Granted automatically to anyone holding cockpit-admin."
      }
    ]
  },
  "users": []
}
